{
  "name": "simf-event-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0 <27.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run payload:generate:types && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "payload:generate:types": "mkdir -p src/generated && payload generate:types",
    "payload:generate:importmap": "payload generate:importmap",
    "migrate:partner-badges": "tsx scripts/migrate-partner-badge-tiers.ts",
    "migrate:approved-copy-fixes": "tsx scripts/migrate-approved-copy-fixes.ts",
    "import:press-releases": "tsx scripts/import-simf-press-releases.ts",
    "export:approved-content": "tsx scripts/export-approved-live-content.ts",
    "import:approved-content": "tsx scripts/import-approved-live-content.ts",
    "verify:press-releases": "tsx scripts/verify-simf-press-releases.ts",
    "verify:tracking": "tsx scripts/verify-attribution.ts && tsx scripts/verify-conversion-tracking.ts && tsx scripts/verify-form-export.ts",
    "verify:media": "tsx scripts/verify-media-webp.ts",
    "verify:secrets": "bash scripts/check-secrets.sh",
    "seed": "tsx scripts/seed-simf-microsite.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/email-nodemailer": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@phosphor-icons/react": "^2.1.10",
    "country-flag-icons": "^1.6.20",
    "graphql": "^16.11.0",
    "motion": "12.23.12",
    "next": "16.3.4",
    "payload": "3.89.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.35.4",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.3.4",
    "prettier": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.21",
    "dompurify": "3.4.15",
    "fast-uri": "3.1.6",
    "framer-motion": "12.23.12",
    "js-yaml": "4.3.2",
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6",
    "nanoid": "3.3.18",
    "nodemailer": "9.1.1",
    "postcss": "8.5.25",
    "sharp": "$sharp"
  }
}
