PAYLOAD_SECRET=replace-with-a-long-random-secret
FORM_SECURITY_SECRET=replace-with-an-independent-long-random-secret
# Use the exact same 32+ character value on startime.sa and sim.startime.sa.
ATTRIBUTION_SECURITY_SECRET=replace-with-a-shared-cross-domain-secret
DATABASE_URL=file:./simf.db
# Production: keep CMS data outside the replaceable application release.
# DATABASE_URL=file:/var/www/simf/shared/simf.db
MEDIA_UPLOAD_DIR=uploads/media
FORM_UPLOAD_DIR=uploads/form-uploads
NEXT_PUBLIC_APP_URL=https://sim.startime.sa
NEXT_PUBLIC_ALLOW_INDEXING=false
PORT=3004

# Server-only transactional email. Never expose these values with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SIM 2026 Website
FORM_NOTIFICATION_EMAIL=sim@startime.sa
FORM_NOTIFICATION_CC=website@startime.sa
